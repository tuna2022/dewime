---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderPlate from "../../components/PlaceholderPlate.astro";
import { SITE } from "../../consts";
import { breadcrumbSchema } from "../../lib/schema";

const services = (await getCollection("services")).sort((a, b) => a.data.order - b.data.order);

const jsonLd = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
]);
---

<BaseLayout
  title="Architecture Services"
  description={`Architectural design, design-build implementation, interior architecture and restoration services from ${SITE.name}, based in ${SITE.address.city}, Türkiye.`}
  path="/services"
  jsonLd={jsonLd}
>
  <section class="px-6 pt-16 pb-12 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Services</p>
      <h1 class="mt-4 max-w-2xl font-display text-4xl text-ink md:text-6xl">
        Four disciplines, one team.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink/75">
        Design and construction stay under one roof, so nothing gets lost between the drawing
        board and the site. <span lang="tr" class="italic">Tasarımdan uygulamaya tek ekip.</span>
      </p>
    </div>
  </section>

  <section class="border-t border-stone-light/70 px-6 py-12 md:px-10 md:py-20">
    <div class="mx-auto flex max-w-6xl flex-col gap-16 md:gap-24">
      {
        services.map((service, i) => (
          <article class="grid gap-8 md:grid-cols-2 md:items-center md:gap-16">
            <PlaceholderPlate
              label={service.data.title}
              seed={i + 5}
              class={`aspect-[4/3] w-full ${i % 2 === 1 ? "md:order-2" : ""}`}
            />
            <div>
              <p class="coord-mark">0{i + 1} — <span lang="tr">{service.data.titleTr}</span></p>
              <h2 class="mt-3 font-display text-3xl text-ink">{service.data.title}</h2>
              <p class="mt-4 text-ink/75">{service.data.summary}</p>
              <a
                href={`/services/${service.id}`}
                class="mt-6 inline-block font-mono text-xs uppercase tracking-[0.14em] text-patina hover:underline"
              >
                Read more →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
