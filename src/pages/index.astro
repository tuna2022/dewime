---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderPlate from "../components/PlaceholderPlate.astro";
import { SITE } from "../consts";
import { faqSchema } from "../lib/schema";
import { stripMarkdown } from "../lib/text";

const practice = (await getCollection("practice")).sort((a, b) => a.data.order - b.data.order);
const allProjects = (await getCollection("interiorProjects")).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);
const faqItems = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
const faqRendered = await Promise.all(faqItems.map((item) => render(item)));

const faqJsonLd = faqSchema(
  faqItems.map((item) => ({
    question: item.data.question,
    answer: stripMarkdown(item.body ?? ""),
  }))
);

const artHouseGallery = [
  { src: "large-abstract-artwork-living-room.jpg", alt: "Large abstract artwork above a travertine console in a contemporary living room", feature: true },
  { src: "art-nouveau-salon-painting.jpg", alt: "Abstract painting above a console table in an Art Nouveau salon", feature: true },
  { src: "bosphorus-painting-istanbul-apartment.jpg", alt: "Gilt-framed Bosphorus painting in an old Istanbul apartment", feature: true },
  { src: "painting-on-wooden-wall.jpg", alt: "Abstract painting on a warm-toned wooden wall" },
  { src: "coastal-painting-mediterranean-home.jpg", alt: "Calm coastal painting above a reclaimed-wood sideboard in a Mediterranean home" },
  { src: "metal-sculpture-walnut-table.jpg", alt: "Elegant metal sculpture on a walnut coffee table" },
  { src: "stone-sculpture-walnut-table.jpg", alt: "Elegant stone sculpture on a walnut dining table" },
  { src: "plaster-sculpture-green-marble.jpg", alt: "Plaster sculpture on a green marble coffee table" },
  { src: "contemporary-painting-compact-living-room.jpg", alt: "Contemporary abstract painting in a compact living room" },
  { src: "contemporary-painting-brick-wall.jpg", alt: "Large contemporary painting on an exposed brick wall" },
  { src: "abstract-painting-stone-farmhouse.jpg", alt: "Abstract painting on a stone wall in a rustic farmhouse living room" },
] as const;
---

<BaseLayout
  title={`${SITE.name} — Interior Design, Home & Office Decor Studio in Istanbul`}
  description={SITE.description}
  path="/"
  jsonLd={faqJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden px-6 pt-16 pb-24 md:px-10 md:pt-24 md:pb-32">
    <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2 md:gap-16">
      <h1
        class="animate-reveal font-display text-5xl font-medium leading-[1.05] tracking-tight text-ink md:text-6xl"
        style="animation-delay: 0ms; opacity: 0;"
      >
        Spaces begin without memory. You give them one.
      </h1>
      <div>
        <p
          class="animate-reveal text-lg text-ink/80 md:text-xl"
          style="animation-delay: 160ms; opacity: 0;"
        >
          {SITE.name} is an {SITE.address.city}-based design and implementation studio. We
          undertake residential, commercial, and restoration projects across Türkiye, handling
          everything from initial visualization to final delivery. Please contact us to purchase
          or commission the production of the artworks, products, and architectural elements
          featured on this site.
        </p>
        <div
          class="animate-reveal mt-10 flex flex-wrap gap-4"
          style="animation-delay: 240ms; opacity: 0;"
        >
          <a
            href="/interior-projects"
            class="bg-ink px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-paper transition-colors hover:bg-patina"
          >
            View projects
          </a>
          <a
            href="/contact"
            class="border border-ink px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-ink transition-colors hover:border-patina hover:text-patina"
          >
            Start a project
          </a>
        </div>
      </div>
    </div>

    <div class="relative mt-10 aspect-[16/9] w-full overflow-hidden md:mt-12 md:aspect-[21/9]">
      <video
        id="hero-video"
        class="h-full w-full object-cover"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/videos/hero-poster.jpg"
      >
        <source src="/videos/hero-loop.mp4" type="video/mp4" />
      </video>
      <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/30 via-transparent to-transparent">
      </div>
      <p class="coord-mark absolute bottom-4 left-4 bg-canvas/70 px-2 py-1 backdrop-blur-sm">
        {SITE.name} — studio work, {SITE.address.city}
      </p>
    </div>
  </section>

  <script>
    // Belt-and-braces: some browsers occasionally ignore the declarative
    // `autoplay` attribute (e.g. after bfcache restores), so also try
    // starting playback programmatically. Muted playback doesn't need a
    // user gesture, so this should succeed everywhere autoplay does.
    const heroVideo = document.getElementById("hero-video") as HTMLVideoElement | null;
    heroVideo?.play().catch(() => {});
  </script>

  <!-- Art and House -->
  <section id="art-and-house" class="scroll-mt-20 border-t border-stone-light/70 bg-paper px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:auto-rows-[200px] md:grid-flow-dense md:gap-6">
        {
          artHouseGallery.map((img) => (
            <img
              src={`/images/art-house/${img.src}`}
              alt={img.alt}
              class={`hover-zoom aspect-[4/3] h-full w-full object-cover ${
                "feature" in img && img.feature
                  ? "col-span-2 aspect-auto md:row-span-2"
                  : ""
              }`}
              loading="lazy"
            />
          ))
        }
      </div>

      <div class="prose-content mx-auto mt-10 max-w-3xl text-ink/85">
        <p class="coord-mark">Art and House</p>
        <p class="mt-6">
          A home is not merely a space where furniture is arranged; it acquires a unique
          character over time through the choices, habits, and accumulated memories of those who
          live there. Artworks can become part of this character: a painting on the wall, a
          sculpture on the dining table, or a small object on a windowsill transforms the way we
          perceive the space around us.
        </p>
        <p>
          The colors of a painting might engage with a wooden wall. The matte surface of a
          plaster sculpture may stand out more vividly against a polished marble table. As
          daylight shifts throughout the day, the artwork's texture, its shadows, and its
          relationship with surrounding objects evolve. Thus, the piece is experienced not just
          at the moment of selection, but continuously throughout the time spent at home.
        </p>
        <p>
          When integrating art into a home, personal connection is just as important as scale,
          lighting, and materials. An artwork might evoke memories of a journey or create space
          for a thought we wish to dwell upon. We might look at a painting we pass every day with
          a different mood, noticing a detail that had previously escaped our attention.
        </p>
        <p>
          Art and House considers artworks in the context of daily life at home. The goal is not
          to fill every corner with art, but to ensure that the right piece—placed in the right
          spot—becomes part of the home's story.
        </p>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="border-t border-stone-light/70 px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[0.9fr_1.5fr]">
      <p class="coord-mark">Design without memories</p>
      <div class="max-w-2xl">
        <p class="font-display text-2xl leading-snug text-ink md:text-3xl">
          A finished building is not a finished space. We design the conditions — light,
          material, structure — and leave the memory to the people who move in.
        </p>
        <p class="mt-6 text-ink/75">
          We work as a single team across design and construction, so the space that gets built
          matches the conditions we set out to create. What it becomes after that — the habits,
          the wear, the traces — was never ours to design in the first place.
        </p>
      </div>
    </div>
  </section>

  <!-- Practice -->
  <section class="border-t border-stone-light/70 bg-paper px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-baseline justify-between gap-4">
        <p class="coord-mark">Practice</p>
        <a href="/practice" class="font-mono text-xs uppercase tracking-[0.14em] text-stone hover:text-ink">
          All disciplines →
        </a>
      </div>
      <div class="mt-10 grid gap-px overflow-hidden border border-stone-light/70 bg-stone-light/70 md:grid-cols-2">
        {
          practice.map((discipline) => (
            <a
              href={`/practice/${discipline.id}`}
              class="group flex flex-col justify-between gap-8 bg-paper p-8 transition-colors hover:bg-canvas md:p-10"
            >
              <div>
                <h3 class="font-display text-2xl text-ink">{discipline.data.title}</h3>
                <p class="mt-1 font-mono text-xs uppercase tracking-[0.1em] text-stone" lang="tr">
                  {discipline.data.titleTr}
                </p>
                <p class="mt-4 text-ink/75">{discipline.data.summary}</p>
              </div>
              <span class="font-mono text-xs uppercase tracking-[0.14em] text-patina group-hover:underline">
                Learn more →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured interior projects -->
  <section class="border-t border-stone-light/70 px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-baseline justify-between gap-4">
        <p class="coord-mark">Selected interior projects</p>
        <a href="/interior-projects" class="font-mono text-xs uppercase tracking-[0.14em] text-stone hover:text-ink">
          All projects →
        </a>
      </div>
      <div class="mt-10 grid gap-10 md:grid-cols-3">
        {
          featuredProjects.map((project, i) => (
            <a href={`/interior-projects/${project.id}`} class="group block">
              {
                project.data.heroImage ? (
                  <div class="w-full overflow-hidden">
                    <img
                      src={project.data.heroImage}
                      alt={`${project.data.title}, ${project.data.city}`}
                      class="hover-zoom h-auto w-full"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <PlaceholderPlate
                    label={`${project.data.title}, ${project.data.city}`}
                    seed={i + 2}
                    class="aspect-[4/5] w-full"
                  />
                )
              }
              <h3 class="mt-4 font-display text-xl text-ink group-hover:text-patina">
                {project.data.title}
              </h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-stone-light/70 bg-paper px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Frequently asked</p>
      <div class="mt-10 divide-y divide-stone-light/70 border-y border-stone-light/70">
        {
          faqItems.map((item, i) => {
            const { Content } = faqRendered[i];
            return (
              <details class="group py-6">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg text-ink">
                  {item.data.question}
                  <span class="font-mono text-stone transition-transform group-open:rotate-45">+</span>
                </summary>
                <div class="mt-3 max-w-2xl text-ink/75">
                  <Content />
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-stone-light/70 bg-ink px-6 py-20 text-canvas md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark text-stone-light">Get in touch</p>
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-snug md:text-4xl">
        Tell us about your site, and we'll tell you what's possible on it.
      </h2>
      <a
        href="/contact"
        class="mt-8 inline-block bg-canvas px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-ink transition-colors hover:bg-patina hover:text-paper"
      >
        Start a project
      </a>
    </div>
  </section>
</BaseLayout>
