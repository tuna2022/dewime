---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderPlate from "../components/PlaceholderPlate.astro";
import { SITE, INTERIOR_PROJECTS_PUBLISHED } from "../consts";
import { faqSchema } from "../lib/schema";
import { stripMarkdown } from "../lib/text";

const practice = (await getCollection("practice")).sort((a, b) => a.data.order - b.data.order);
const allProjects = (await getCollection("interiorProjects")).sort((a, b) => a.data.order - b.data.order);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);
const faqItems = (await getCollection("faq")).sort((a, b) => a.data.order - b.data.order);
const faqRendered = await Promise.all(faqItems.map((item) => render(item)));

const faqJsonLd = faqSchema(
  faqItems.map((item) => ({
    question: item.data.question,
    answer: stripMarkdown(item.body ?? ""),
  }))
);

// Order matters for the grid: wide, four small, wide, two features, wide, so both
// the 4-column desktop grid and the 2-column mobile grid close every row.
// "wide" photos span the full gallery width. Each photo has its caption underneath.
const artHouseGallery = [
  { src: "brick-garden-pavilion.jpg",
    title: "Brick Wall Construction: Waterproofing and Foundation Drainage Techniques",
    caption: "Proper foundation waterproofing is essential for preventing moisture penetration and structural deterioration. The illustration compares an unprotected brick foundation with an effective drainage system. The construction process involves applying a waterproof membrane to the foundation wall, installing a protective drainage board, and placing a perforated drainage pipe within a gravel-filled trench. A geotextile filter prevents soil particles from clogging the system. This method redirects groundwater away from the structure, reducing hydrostatic pressure, rising damp, and long-term moisture damage.",
    alt: "Brick-walled garden pavilion with full-height glazing under mature trees", wide: true,
    // "hover" photos are revealed on hover (or tap/focus on touch screens).
    hover: { src: "brick-wall-drainage-before-after.jpg", alt: "Cross-section of a brick wall: on the left, groundwater and rising damp soak into the masonry; on the right, a drainage membrane, gravel backfill and perforated pipe keep it dry" } },
  { src: "bronze-handrail-lit-staircase.jpg", caption: "Bronze handrails are a premium architectural choice that blends timeless elegance with exceptional durability. Over time, the metal develops a rich, natural patina that enhances its character and unique visual appeal. Beyond aesthetics, bronze possesses inherent antimicrobial properties, making it an excellent option for high-traffic areas. It is highly resistant to corrosion and wear, ensuring the railing maintains its structural integrity for decades. Whether paired with modern glass or traditional wood, bronze handrails add a sophisticated, luxurious touch to any space. Furthermore, this versatile material responds beautifully to modern lighting techniques, transforming a simple architectural feature into a stunning sculptural element when illuminated from below. Ultimately, incorporating bronze is not just a design preference, but a lasting investment that elevates the overall atmosphere of a building.", alt: "Folded bronze handrail returning into a plaster wall above an oak staircase with lit treads" },
  { src: "carved-stone-door-surround.jpg", caption: "Palm and wave motifs, hand-carved into natural stone, lend structures both a Mediterranean-inspired warmth and a timeless elegance. Palm leaves—symbols of abundance and victory since ancient times—create a bold yet inviting presence at the entrance. Complementing this, rhythmic wave motifs introduce fluidity and dynamism, softening the inherent rigidity of the stone. By uniting these two powerful elements of nature, this exquisite stonework highlights the building’s character from the very first step. Serving as a focal point in architectural projects, this stone surround—beyond its aesthetic appeal—becomes a lasting work of art, destined to endure for generations thanks to the inherent durability of the material.", alt: "Hand-carved stone door surround with palm and wave relief at a garden entrance" },
  { src: "natural-stone-garden-steps.jpg", caption: "The combination of carefully crafted natural stone and vibrant vegetation creates a striking visual balance in garden and outdoor space designs. Blending the firm texture of stone with the softness of greenery and colorful flowers lends the space both an organic flow and a timeless character. Stone pathways, retaining walls, or decorative rocks define the natural boundaries of the landscape while echoing the inherent order found in nature itself. Over time, the natural patinas that develop on the stones, combined with the evolving growth stages of the plants, transform this harmony into a living, breathing work of art that flourishes through every season. This integration—achieved through the thoughtful selection of stone and the strategic placement of plants—not only enhances the aesthetic appeal of outdoor areas but also creates enduring and inviting spaces.", alt: "Rough natural stone garden steps beside a lit travertine terrace and planted beds" },
  { src: "steel-balcony-railing.jpg", caption: "Balconies constructed with a bolted steel framework offer the industrial aesthetic sought by modern architecture, combined with high structural integrity and a minimalist sensibility. Opting for bolted connections rather than welds facilitates ease of assembly while lending the structure a sleek, precise engineering detail. Complementing this robust steel frame, horizontal railings create an uninterrupted linearity across the facade, adding depth and a contemporary flair to the space. These slender, elongated horizontal profiles ensure that sightlines remain unobstructed, maximizing the connection with the outdoors. The durability of the metal, harmonized with this modern design language, creates a long-lasting and striking focal point—an ideal feature for loft-style or contemporary facade designs.", alt: "Bolted steel balcony with a horizontal rod railing against a clear sky" },
  { src: "timber-lattice-folding-shutters.jpg",
    title: "Timber lattice shutters",
    caption: [
      "Teak and Iroko are resistant to decay, thanks to their high content of natural oils (teak oil) and silica. However, if these natural oils are not managed skillfully during the kiln-drying and processing stages, they can become a significant liability.",
      "• The Secret of Craftsmanship: When Iroko or Teak is kiln-dried too rapidly at high temperatures, the outer layers dry quickly while the core remains moist—a phenomenon known as “case-hardening” (or shell-hardening stress). As soon as such timber is sliced into thin slats for a lattice, the internal tension is released, causing the slats to twist instantly along their axis. A skilled manufacturer will allow the timber to rest (condition) in the workshop environment for at least 2–3 weeks after kiln-drying to relieve this internal stress.",
      "• Furthermore, before the slats are joined—whether via mortise-and-tenon or dowel joints—the natural oils on the mating surfaces must be completely removed (degreased) using acetone or a paint thinner. Subsequently, a polyurethane-based, D4-grade marine adhesive should be applied. Failure to do so will result in the wood’s own natural oils preventing the glue from bonding, eventually causing the lattice joints to pull apart.",
    ],
    alt: "Folding timber lattice shutters casting a grid of light across a white facade", wide: true,
    hover: { src: "timber-lattice-panel-workshop.jpg", alt: "Interlocking timber lattice panel being assembled on a workbench in the joinery shop" } },
  { src: "black-slatted-balconies-brick-facade.jpg",
    caption: "Anticipating Heat Build-up: As welding progresses, the base metal heats up, and the workpiece’s capacity to dissipate heat decreases. While an inexperienced welder might continue at the same speed and current—risking burn-through or deformation of the part—a skilled welder, as they approach the end of the weld, will slightly adjust the torch angle and increase the welding speed in a controlled manner, maintaining a perfect balance between penetration and heat input.",
    alt: "Black vertical-slat balconies projecting from a brick facade at sunset", feature: true,
    hover: { src: "tig-welding-steel-frame.jpg", alt: "Welder in an auto-darkening helmet TIG-welding the corner of a steel frame, sparks flying in a dark workshop" } },
  { src: "corten-steel-planters-entrance.jpg", caption: "Rust Run-off (Staining): During the first few months of the weathering process, rain will cause the steel to bleed carbon and rust particles. This run-off can permanently stain light-colored concrete, stone, or paved patio slabs underneath. Placing them over gravel, grass, or using drip trays can prevent this.", alt: "Angled corten steel planters with trailing plants at a timber-clad entrance", feature: true,
    hover: { src: "corten-wall-rust-staining-comparison.jpg", alt: "Two corten steel walls: one set in gravel with no staining, the other above pale paving streaked with orange rust run-off" } },
  { src: "graffiti-mural-office-lounge.jpg",
    title: "Wall Surface Preparation for Graffiti Application",
    // An array caption renders as separate paragraphs.
    caption: [
      "Before painting, the wall must be inspected for cracks, moisture penetration, loose coatings, and structural defects. All surfaces should be thoroughly cleaned to remove dust, grease, efflorescence, and deteriorated paint using appropriate mechanical or chemical methods.",
      "Cracks and surface irregularities must be repaired with compatible fillers or cement-based repair mortars. Once repaired, the substrate should be allowed to cure and dry according to the manufacturer's specifications. Outdoor murals and artworks exposed to direct sunlight are vulnerable to ultraviolet (UV) radiation, which can cause pigment degradation, color fading, and deterioration of the paint's polymer binder. Prolonged exposure, combined with temperature fluctuations and moisture, may also contribute to cracking, chalking, and delamination.",
      "Applying a UV-resistant clear varnish creates a protective coating that helps reduce photochemical degradation. High-performance acrylic or polyurethane varnishes containing UV absorbers and hindered amine light stabilizers (HALS) can improve color retention and coating durability.",
    ],
    alt: "Large graffiti mural behind a blue sofa and leather lounge chairs in an industrial office", wide: true,
    hover: { src: "graffiti-wall-coating-and-painting.jpg", alt: "Two views of mural work: a spray gun applying a clear coat over a graffiti wall, and two painters on a rolling scaffold painting a large graffiti mural in a warehouse" } },
] as const;
---

<BaseLayout
  title={`${SITE.name} — Interior Design, Home & Office Decor Studio in Istanbul`}
  description={SITE.description}
  path="/"
  jsonLd={faqJsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <img
      src="/images/home/stonemason-measuring-stone.jpg"
      alt="Craftsman measuring a rough-cut stone block with a steel square in a stone workshop"
      width="1448"
      height="1086"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-ink/80 via-ink/65 to-ink/50 md:via-ink/35 md:to-ink/10">
    </div>

    <!-- md+: the box takes the photo's own 4:3 ratio, so the whole image shows uncropped. -->
    <div class="relative px-6 pt-16 pb-24 md:aspect-[1448/1086] md:px-10 md:pt-24">
      <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2 md:gap-16">
        <h1
          class="animate-reveal font-display text-5xl font-medium leading-[1.05] tracking-tight text-paper md:text-6xl"
          style="animation-delay: 0ms; opacity: 0;"
        >
          Design without memories
        </h1>
        <div>
          <p
            class="animate-reveal text-lg text-paper/90 md:text-xl"
            style="animation-delay: 160ms; opacity: 0;"
          >
            {SITE.name} is an {SITE.address.city}-based studio. We create bespoke products for
            residential, commercial, and restoration projects. We manage the entire process, from
            initial visualization to final delivery, working in collaboration with project
            engineers, designers, and architects. We specialize in the production of design-led
            pieces that require expert craftsmanship.
          </p>
          <div
            class="animate-reveal mt-10 flex flex-wrap gap-4"
            style="animation-delay: 240ms; opacity: 0;"
          >
            {INTERIOR_PROJECTS_PUBLISHED && (
              <a
                href="/interior-projects"
                class="bg-paper px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-ink transition-colors hover:bg-patina hover:text-paper"
              >
                View projects
              </a>
            )}
            <a
              href="/contact"
              class="border border-paper px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-paper transition-colors hover:bg-paper hover:text-ink"
            >
              Start a project
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Art and House -->
  <section id="art-and-house" class="scroll-mt-20 border-t border-stone-light/70 bg-paper px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-6xl">
      <div class="grid grid-cols-2 gap-x-4 gap-y-6 md:grid-cols-4 md:gap-x-6 md:gap-y-8">
        {
          artHouseGallery.map((img) => {
            const wide = "wide" in img && img.wide;
            const feature = "feature" in img && img.feature;
            return (
              <figure class={wide ? "col-span-2 md:col-span-4" : feature ? "col-span-2" : ""}>
                {"hover" in img ? (
                  <div class="group relative cursor-pointer" tabindex="0">
                    <img
                      src={`/images/art-house/${img.src}`}
                      alt={img.alt}
                      class={`block w-full object-cover ${wide ? "aspect-[16/9]" : "aspect-[3/2]"}`}
                      loading="lazy"
                    />
                    <img
                      src={`/images/art-house/${img.hover.src}`}
                      alt={img.hover.alt}
                      class="absolute inset-0 h-full w-full bg-paper object-contain opacity-0 transition-opacity duration-500 group-hover:opacity-100 group-focus:opacity-100"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <img
                    src={`/images/art-house/${img.src}`}
                    alt={img.alt}
                    class={`block w-full object-cover ${
                      wide ? "aspect-[16/9]" : feature ? "hover-zoom aspect-[3/2]" : "hover-zoom aspect-[4/3]"
                    }`}
                    loading="lazy"
                  />
                )}
                <figcaption class="mt-2 text-sm leading-snug text-ink/70">
                  {"title" in img && (
                    <span class="mt-4 mb-2 block font-display text-xl uppercase leading-tight text-ink md:text-2xl">
                      {img.title}
                    </span>
                  )}
                  {Array.isArray(img.caption)
                    ? img.caption.map((para, i) => <span class={`block ${i > 0 ? "mt-2" : ""}`}>{para}</span>)
                    : img.caption}
                </figcaption>
              </figure>
            );
          })
        }
      </div>

      <div class="prose-content mx-auto mt-10 max-w-3xl text-ink/85">
        <p class="coord-mark">Art and House</p>
        <p class="mt-6">
          A home is not merely a space where furniture is arranged; it acquires a unique
          character over time through the choices, habits, and accumulated memories of those who
          live there. Artworks can become part of this character: a painting on the wall, a
          sculpture on the dining table, or a small object on a windowsill transforms the way we
          perceive the space around us.
        </p>
        <p>
          The colors of a painting might engage with a wooden wall. The matte surface of a
          plaster sculpture may stand out more vividly against a polished marble table. As
          daylight shifts throughout the day, the artwork's texture, its shadows, and its
          relationship with surrounding objects evolve. Thus, the piece is experienced not just
          at the moment of selection, but continuously throughout the time spent at home.
        </p>
        <p>
          When integrating art into a home, personal connection is just as important as scale,
          lighting, and materials. An artwork might evoke memories of a journey or create space
          for a thought we wish to dwell upon. We might look at a painting we pass every day with
          a different mood, noticing a detail that had previously escaped our attention.
        </p>
        <p>
          Art and House considers artworks in the context of daily life at home. The goal is not
          to fill every corner with art, but to ensure that the right piece—placed in the right
          spot—becomes part of the home's story.
        </p>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="border-t border-stone-light/70 px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto grid max-w-6xl gap-10 md:grid-cols-[0.9fr_1.5fr]">
      <p class="coord-mark">Design without memories</p>
      <div class="max-w-2xl">
        <p class="font-display text-2xl leading-snug text-ink md:text-3xl">
          A finished building is not a finished space. We design the conditions — light,
          material, structure — and leave the memory to the people who move in.
        </p>
        <p class="mt-6 text-ink/75">
          We work as a single team across design and construction, so the space that gets built
          matches the conditions we set out to create. What it becomes after that — the habits,
          the wear, the traces — was never ours to design in the first place.
        </p>
      </div>
    </div>
  </section>

  <!-- Practice -->
  <section class="border-t border-stone-light/70 bg-paper px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-baseline justify-between gap-4">
        <p class="coord-mark">Practice</p>
        <a href="/practice" class="font-mono text-xs uppercase tracking-[0.14em] text-stone hover:text-ink">
          All disciplines →
        </a>
      </div>
      <div class="mt-10 grid gap-px overflow-hidden border border-stone-light/70 bg-stone-light/70 md:grid-cols-2">
        {
          practice.map((discipline) => (
            <a
              href={`/practice/${discipline.id}`}
              class="group flex flex-col justify-between gap-8 bg-paper p-8 transition-colors hover:bg-canvas md:p-10"
            >
              <div>
                <h3 class="font-display text-2xl text-ink">{discipline.data.title}</h3>
                <p class="mt-1 font-mono text-xs uppercase tracking-[0.1em] text-stone" lang="tr">
                  {discipline.data.titleTr}
                </p>
                <p class="mt-4 text-ink/75">{discipline.data.summary}</p>
              </div>
              <span class="font-mono text-xs uppercase tracking-[0.14em] text-patina group-hover:underline">
                Learn more →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Featured interior projects -->
  {INTERIOR_PROJECTS_PUBLISHED && (
  <section class="border-t border-stone-light/70 px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <div class="flex items-baseline justify-between gap-4">
        <p class="coord-mark">Selected interior projects</p>
        <a href="/interior-projects" class="font-mono text-xs uppercase tracking-[0.14em] text-stone hover:text-ink">
          All projects →
        </a>
      </div>
      <div class="mt-10 grid gap-10 md:grid-cols-3">
        {
          featuredProjects.map((project, i) => (
            <a href={`/interior-projects/${project.id}`} class="group block">
              {
                project.data.heroImage ? (
                  <div class="w-full overflow-hidden">
                    <img
                      src={project.data.heroImage}
                      alt={`${project.data.title}, ${project.data.city}`}
                      class="hover-zoom h-auto w-full"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <PlaceholderPlate
                    label={`${project.data.title}, ${project.data.city}`}
                    seed={i + 2}
                    class="aspect-[4/5] w-full"
                  />
                )
              }
              <h3 class="mt-4 font-display text-xl text-ink group-hover:text-patina">
                {project.data.title}
              </h3>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  )}

  <!-- FAQ -->
  <section class="border-t border-stone-light/70 bg-paper px-6 py-20 md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Frequently asked</p>
      <div class="mt-10 divide-y divide-stone-light/70 border-y border-stone-light/70">
        {
          faqItems.map((item, i) => {
            const { Content } = faqRendered[i];
            return (
              <details class="group py-6">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg text-ink">
                  {item.data.question}
                  <span class="font-mono text-stone transition-transform group-open:rotate-45">+</span>
                </summary>
                <div class="mt-3 max-w-2xl text-ink/75">
                  <Content />
                </div>
              </details>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-stone-light/70 bg-ink px-6 py-20 text-canvas md:px-10 md:py-28">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark text-stone-light">Get in touch</p>
      <h2 class="mt-4 max-w-2xl font-display text-3xl leading-snug md:text-4xl">
        Tell us about your site, and we'll tell you what's possible on it.
      </h2>
      <a
        href="/contact"
        class="mt-8 inline-block bg-canvas px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-ink transition-colors hover:bg-patina hover:text-paper"
      >
        Start a project
      </a>
    </div>
  </section>
</BaseLayout>
