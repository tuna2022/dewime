---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderPlate from "../../components/PlaceholderPlate.astro";
import { breadcrumbSchema, productSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { id: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Products Design", path: "/products" },
    { name: product.data.title, path: `/products/${product.id}` },
  ]),
  productSchema({
    title: product.data.title,
    material: product.data.material,
    summary: product.data.summary,
    path: `/products/${product.id}`,
  }),
];
---

<BaseLayout
  title={product.data.title}
  description={product.data.summary}
  path={`/products/${product.id}`}
  jsonLd={jsonLd}
>
  <section class="px-6 pt-16 pb-8 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <a href="/products" class="font-mono text-xs uppercase tracking-[0.14em] text-stone hover:text-ink">
        ← All products
      </a>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="coord-mark">{product.data.category}</p>
          <h1 class="mt-3 font-display text-4xl text-ink md:text-5xl">{product.data.title}</h1>
        </div>
        <dl class="grid grid-cols-2 gap-6 font-mono text-xs uppercase tracking-[0.08em] text-stone">
          <div>
            <dt>Material</dt>
            <dd class="mt-1 text-ink">{product.data.material}</dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd class="mt-1 text-ink">{product.data.year}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  {
    product.data.heroImage ? (
      <div class="mx-auto w-full max-w-6xl">
        <img
          src={product.data.heroImage}
          alt={product.data.summary}
          class="hover-zoom h-auto w-full"
        />
      </div>
    ) : (
      <PlaceholderPlate
        label={product.data.title}
        seed={product.data.order + 60}
        class="mx-auto aspect-[16/9] w-full max-w-6xl"
      />
    )
  }

  <section class="px-6 py-16 md:px-10 md:py-24">
    <div class="prose-content mx-auto max-w-3xl text-ink/85">
      <Content />
    </div>

    {
      product.data.detailImage && (
        <div class="mx-auto mt-16 max-w-3xl">
          <p class="coord-mark">Construction detail</p>
          <img
            src={product.data.detailImage}
            alt={`Construction drawing for ${product.data.title}`}
            class="hover-zoom mt-6 h-auto w-full border border-stone-light/70"
            loading="lazy"
          />
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .prose-content :global(p) {
    margin-top: 1.25rem;
  }

  .prose-content :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
