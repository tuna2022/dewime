---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema } from "../lib/schema";

const description =
  "Metalworks — cutting, grinding, turning and welding steel in the workshop, where design-led pieces are built by hand.";

const jsonLd = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Metalworks", path: "/metalworks" },
]);

const photos = [
  {
    src: "/images/metalworks/bench-grinder-sparks.jpg",
    alt: "Gloved hands grinding a steel part on a bench grinder, sparks falling into a metal tray",
    width: 1672,
    height: 941,
  },
  {
    src: "/images/metalworks/mig-welding-steel-frame.jpg",
    alt: "Welder in a protective helmet MIG-welding a steel frame, sparks fanning across the workbench",
    width: 1672,
    height: 941,
  },
  {
    src: "/images/metalworks/metal-fabrication-workshop.jpg",
    alt: "Metal fabrication workshop with a milling machine, lathe, steel stock racks and tool cart",
    width: 1672,
    height: 941,
  },
  {
    src: "/images/metalworks/lathe-turning-steel-disc.jpg",
    alt: "Lathe tool post turning a polished steel disc under a stream of coolant",
    width: 1672,
    height: 941,
  },
  {
    src: "/images/metalworks/angle-grinder-cutting-steel-tube.jpg",
    alt: "Gloved hands cutting a square steel tube with an angle grinder, a wide spray of sparks",
    width: 1935,
    height: 812,
  },
];
---

<BaseLayout title="Metalworks" description={description} path="/metalworks" jsonLd={jsonLd}>
  <section class="px-6 pt-16 pb-10 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Workshop</p>
      <h1 class="mt-3 font-display text-4xl text-ink md:text-5xl">Metalworks</h1>
    </div>
  </section>

  <section class="flex flex-col gap-2 pb-16 md:gap-4 md:pb-24">
    {
      photos.map((photo, i) => (
        <img
          src={photo.src}
          alt={photo.alt}
          width={photo.width}
          height={photo.height}
          loading={i === 0 ? "eager" : "lazy"}
          class="block h-auto w-full"
        />
      ))
    }
  </section>
</BaseLayout>
