---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderPlate from "../../components/PlaceholderPlate.astro";
import { breadcrumbSchema, projectSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const projects = await getCollection("interiorProjects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const jsonLd = [
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Interior Projects", path: "/interior-projects" },
    { name: project.data.title, path: `/interior-projects/${project.id}` },
  ]),
  projectSchema({
    title: project.data.title,
    city: project.data.city,
    year: project.data.year,
    summary: project.data.summary,
    path: `/interior-projects/${project.id}`,
  }),
];
---

<BaseLayout
  title={`${project.data.title} — ${project.data.city}`}
  description={project.data.summary}
  path={`/interior-projects/${project.id}`}
  jsonLd={jsonLd}
>
  <section class="px-6 pt-16 pb-8 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <a href="/interior-projects" class="font-mono text-xs uppercase tracking-[0.14em] text-stone hover:text-ink">
        ← All interior projects
      </a>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="coord-mark">{project.data.category}</p>
          <h1 class="mt-3 font-display text-4xl text-ink md:text-5xl">{project.data.title}</h1>
        </div>
        <dl class="grid grid-cols-3 gap-6 font-mono text-xs uppercase tracking-[0.08em] text-stone">
          <div>
            <dt>Location</dt>
            <dd class="mt-1 text-ink">{project.data.city}</dd>
          </div>
          <div>
            <dt>Year</dt>
            <dd class="mt-1 text-ink">{project.data.year}</dd>
          </div>
          <div>
            <dt>Area</dt>
            <dd class="mt-1 text-ink">{project.data.area}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <PlaceholderPlate
    label={`${project.data.title}, ${project.data.city}`}
    seed={project.data.order + 30}
    class="mx-auto aspect-[16/9] w-full max-w-6xl"
  />

  <section class="px-6 py-16 md:px-10 md:py-24">
    <div class="prose-content mx-auto max-w-3xl text-ink/85">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .prose-content :global(p) {
    margin-top: 1.25rem;
  }

  .prose-content :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
