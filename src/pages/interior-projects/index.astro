---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderPlate from "../../components/PlaceholderPlate.astro";
import { SITE } from "../../consts";
import { breadcrumbSchema } from "../../lib/schema";

const projects = (await getCollection("interiorProjects")).sort((a, b) => b.data.year - a.data.year);

const jsonLd = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Interior Projects", path: "/interior-projects" },
]);

const goldenHourGallery = [
  { src: "living-room.jpg", alt: "Golden-hour living room with a city-skyline view through floor-to-ceiling glass", feature: true },
  { src: "bedroom-skyline.jpg", alt: "Primary bedroom at golden hour with a skyline view", feature: true },
  { src: "kitchen.jpg", alt: "Marble kitchen island at golden hour with skyline view beyond", feature: true },
  { src: "living-room-vignette.jpg", alt: "Living room seating vignette in golden-hour light" },
  { src: "bedroom-retreat.jpg", alt: "Bedroom retreat seating area at golden hour" },
  { src: "kitchen-sunset.jpg", alt: "Kitchen at sunset with skyline silhouette" },
  { src: "kitchen-island.jpg", alt: "Marble waterfall kitchen island with brass accents" },
  { src: "bathroom.jpg", alt: "Spa-style marble bathroom at golden hour" },
  { src: "walk-in-closet.jpg", alt: "Walk-in closet with warm evening light" },
  { src: "reading-nook.jpg", alt: "Reading nook styled with warm light" },
  { src: "kids-bedroom.jpg", alt: "Sunlit children's bedroom" },
  { src: "brass-lamp-console.jpg", alt: "Brass lamp detail on a marble console" },
  { src: "foyer-console.jpg", alt: "Entry foyer with marble console and skyline view beyond" },
  { src: "floral-vignette.jpg", alt: "Floral still life vignette in sunlit interior" },
] as const;

const goldenHourDetails = [
  { src: "construction-detail/kitchen-island-blueprint.jpg", alt: "Construction drawing for the marble kitchen island" },
  { src: "construction-detail/bookshelf-led-detail.jpg", alt: "LED joinery detail drawing for a built-in bookshelf" },
  { src: "construction-detail/console-technical-drawing.jpg", alt: "Technical drawing for a marble console table" },
] as const;

const sunlitCoastalGallery = [
  { src: "living-room.jpg", alt: "Sunlit coastal living room opening onto the sea, with a stone fireplace and linen sofa", feature: true },
  { src: "terrace.jpg", alt: "Sea-view terrace with wicker furniture and olive trees", feature: true },
  { src: "kitchen.jpg", alt: "Coastal kitchen with light-colored walls and natural wood cabinetry", feature: true },
  { src: "bedroom-retreat.jpg", alt: "Sunlit bedroom retreat with linen bedding and blue accents" },
  { src: "bathroom.jpg", alt: "Coastal bathroom with stone surfaces and natural light" },
  { src: "entryway.jpg", alt: "Entryway by the sea with distressed wood and wicker details" },
  { src: "lounge.jpg", alt: "Coastal retreat lounge with natural materials and warm textures" },
  { src: "kitchen-pendants.jpg", alt: "Wicker pendant lights over a coastal kitchen counter" },
] as const;
---

<BaseLayout
  title="Interior Projects"
  description={`Residential, commercial and restoration interiors by ${SITE.name} across ${SITE.areaServed.join(", ")} and beyond.`}
  path="/interior-projects"
  jsonLd={jsonLd}
>
  <section class="px-6 pt-16 pb-12 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Interior Projects</p>
      <h1 class="mt-4 max-w-2xl font-display text-4xl text-ink md:text-6xl">
        Built interiors across Türkiye.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink/75">
        {SITE.areaServed.join(" · ")}
      </p>
    </div>
  </section>

  <section class="border-t border-stone-light/70 bg-paper px-6 py-16 md:px-10 md:py-24">
    <div class="prose-content mx-auto max-w-3xl text-ink/85">
      <p class="coord-mark">Notes on memory</p>
      <p class="mt-6">
        One of the most common issues in luxury residential design is that the space appears
        overly flawless the moment it is completed. On paper, there is a strong composition, the
        right materials, balanced proportions, impressive lighting, and carefully selected
        furniture. In the renderings, everything is perfectly in place. The space looks
        aesthetically complete—yet it has not yet been lived in.
      </p>
      <p>
        What emerges at this stage is often not a true "place," but rather a well-designed space
        devoid of memory.
      </p>
      <p>
        A house transforms into a living space only when people begin to inhabit it. For a home
        is not merely an architectural shell. The way morning light falls on a particular
        armchair, the specific corner of a table where work is consistently done, the window by
        which coffee is enjoyed, the hallway where children run, and the spot where guests
        gather—these elements shape the character of the space over time. None of these
        behaviors can be fully replicated in a drawing.
      </p>
      <p>The designer creates the physical framework of the space, but it is the user who creates its memory.</p>
      <p>
        This is particularly significant in luxury design, where the concept of "perfection"
        often dominates high-budget projects. There is a desire for surfaces to remain
        unblemished, furniture to stay pristine, and materials to resist aging. Yet, it is
        precisely these traces that reveal a home has truly been lived in. Slight wear on a stone
        surface, the way a leather armchair molds to the body over time, tonal variations in the
        wood flooring, or the sheen that develops on a frequently touched door handle—these
        details make the space's history visible.
      </p>
      <p>These traces are not flaws; they are memories.</p>
      <p>
        A design that looks beautiful on paper encounters the real world for the first time only
        after execution. Scale, light, sound, materials, and the human body put the design's
        integrity to the test. Then, as the space is put to use, the design undergoes a second
        transformation. People use certain spaces differently than the designer envisioned; they
        rearrange furniture, introduce new objects, and adapt the setting to their own
        lifestyles.
      </p>
      <p>
        Therefore, a high-quality luxury residential design should not be a system that dictates
        every detail in advance. On the contrary, it should allow for the flexibility to let the
        user transform the space over time.
      </p>
      <p>
        Perhaps true luxury is not a home that looks flawless on day one, but rather a space
        that—even after a decade—bears the imprint of the people who live there, evolving while
        retaining its value.
      </p>
      <p>For the architect designs the space.</p>
      <p>But it is the people living within it who imbue that space with memory.</p>
    </div>
  </section>

  <section class="border-t border-stone-light/70 px-6 py-12 md:px-10 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <a href={`/interior-projects/${project.id}`} class="group block">
            <PlaceholderPlate
              label={`${project.data.title}, ${project.data.city}`}
              seed={i + 20}
              class="aspect-[4/5] w-full"
            />
            <p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] text-stone">
              {project.data.city} · {project.data.year} · {project.data.category}
            </p>
            <h2 class="mt-1 font-display text-xl text-ink group-hover:text-patina">
              {project.data.title}
            </h2>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-t border-stone-light/70 bg-paper px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Mood study</p>
      <h2 class="mt-3 font-display text-3xl text-ink md:text-4xl">Mediterranean Atmosphere</h2>
      <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-stone" lang="tr">
        Akdeniz Havası
      </p>
      <p class="mt-6 max-w-xl text-ink/75">
        Travertine, alabaster and warm brass — a study in the material palette of a Mediterranean
        house.
      </p>

      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 md:auto-rows-[200px] md:grid-flow-dense md:gap-6">
        <img
          src="/images/interior-projects/mediterranean-atmosphere/living-room.jpg"
          alt="Warm Mediterranean-style living room with a travertine coffee table, bouclé sectional sofa and olive branches"
          class="hover-zoom col-span-2 aspect-[4/3] h-full w-full object-cover md:row-span-2 md:aspect-auto"
          loading="lazy"
        />
        <img
          src="/images/interior-projects/mediterranean-atmosphere/kitchen.jpg"
          alt="Warm Mediterranean kitchen with a marble island and brass pendant lighting"
          class="hover-zoom aspect-[4/3] h-full w-full object-cover"
          loading="lazy"
        />
        <img
          src="/images/interior-projects/mediterranean-atmosphere/bathroom.jpg"
          alt="Marble bathroom with a freestanding stone tub, olive tree and mountain view"
          class="hover-zoom aspect-[4/3] h-full w-full object-cover"
          loading="lazy"
        />
        <img
          src="/images/interior-projects/mediterranean-atmosphere/bedroom.jpg"
          alt="Mediterranean-style bedroom with alabaster pendant lights and a sea view"
          class="hover-zoom col-span-2 aspect-[4/3] h-full w-full object-cover md:row-span-2 md:aspect-auto"
          loading="lazy"
        />
        <img
          src="/images/interior-projects/mediterranean-atmosphere/bedside-vignette.jpg"
          alt="Bedside vignette with a travertine nightstand and alabaster pendant light"
          class="hover-zoom col-span-2 aspect-[4/3] h-full w-full object-cover md:col-span-1"
          loading="lazy"
        />
      </div>

      <p class="mt-6 max-w-2xl font-mono text-xs uppercase tracking-[0.08em] text-stone">
        These images are AI-generated — a study of a memory-less space, not a built project.
        <span lang="tr" class="block normal-case not-italic tracking-normal">
          Bu görseller yapay zekâ ile üretilmiştir; hafızasız bir mekân tasarımı çalışmasıdır,
          uygulanmış bir proje değildir.
        </span>
      </p>
    </div>
  </section>

  <section class="border-t border-stone-light/70 px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Concept study</p>
      <h2 class="mt-3 font-display text-3xl text-ink md:text-4xl">Golden Hour Skyline</h2>

      <div class="prose-content mt-6 max-w-2xl text-ink/85">
        <p>
          This apartment appears complete, flawless, and perfectly arranged; yet, it lacks a
          history of its own. Furniture has been selected, surfaces finished, lighting schemes
          established, and every detail resolved within a cohesive aesthetic framework. Despite
          this, the space does not yet bear the traces of its inhabitants.
        </p>
        <p>
          For a home's memory is not something handed over alongside the design. Memory is
          forged through evenings spent on the same sofa, habits repeated in the kitchen, a
          photograph hung on the wall later on, marks left by children, and the way belongings
          evolve over time.
        </p>
        <p>
          Therefore, we view this apartment not as a finished space, but as a foundation whose
          memory has yet to begin. Design merely sets the initial conditions; it is the life
          lived within that will truly complete the home.
        </p>
      </div>

      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 md:auto-rows-[180px] md:grid-flow-dense md:gap-6">
        {
          goldenHourGallery.map((img) => (
            <img
              src={`/images/interior-projects/golden-hour-skyline/${img.src}`}
              alt={img.alt}
              class={`hover-zoom aspect-[4/3] h-full w-full object-cover ${
                "feature" in img && img.feature
                  ? "col-span-2 aspect-auto md:row-span-2"
                  : ""
              }`}
              loading="lazy"
            />
          ))
        }
      </div>

      <p class="mt-16 coord-mark">Construction detail</p>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          goldenHourDetails.map((img) => (
            <img
              src={`/images/interior-projects/golden-hour-skyline/${img.src}`}
              alt={img.alt}
              class="hover-zoom aspect-[4/3] w-full border border-stone-light/70 object-cover"
              loading="lazy"
            />
          ))
        }
      </div>

      <p class="mt-10 max-w-2xl font-mono text-xs uppercase tracking-[0.08em] text-stone">
        These images are AI-generated — a concept study, not a built project.
        <span lang="tr" class="block normal-case not-italic tracking-normal">
          Bu görseller yapay zekâ ile üretilmiştir; bir konsept çalışmasıdır, uygulanmış bir
          proje değildir.
        </span>
      </p>
    </div>
  </section>

  <section class="border-t border-stone-light/70 bg-paper px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Concept study</p>
      <h2 class="mt-3 font-display text-3xl text-ink md:text-4xl">Sunlit Mediterranean Coastal</h2>

      <p class="mt-6 max-w-2xl text-ink/85">
        The interior design of this home blends the simplicity of coastal living with natural
        materials and warm textures. Light-colored walls, stone surfaces, distressed wood
        furniture, linen fabrics, and wicker details lend the space a calm, timeless, and
        lived-in character. While blue tones establish a visual connection to the sea, expansive
        openings and abundant natural light blur the boundary between the interior and the
        veranda. The overall approach focuses on creating a living environment that is natural,
        comfortable, and capable of developing its own unique history over time, rather than one
        that is ostentatious.
      </p>

      <div class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4 md:auto-rows-[200px] md:grid-flow-dense md:gap-6">
        {
          sunlitCoastalGallery.map((img) => (
            <img
              src={`/images/interior-projects/sunlit-mediterranean-coastal/${img.src}`}
              alt={img.alt}
              class={`hover-zoom aspect-[4/3] h-full w-full object-cover ${
                "feature" in img && img.feature
                  ? "col-span-2 aspect-auto md:row-span-2"
                  : ""
              }`}
              loading="lazy"
            />
          ))
        }
      </div>

      <p class="mt-10 max-w-2xl font-mono text-xs uppercase tracking-[0.08em] text-stone">
        These images are AI-generated — a concept study, not a built project.
        <span lang="tr" class="block normal-case not-italic tracking-normal">
          Bu görseller yapay zekâ ile üretilmiştir; bir konsept çalışmasıdır, uygulanmış bir
          proje değildir.
        </span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-content :global(p) {
    margin-top: 1.5rem;
  }

  .prose-content :global(p:first-child) {
    margin-top: 0;
  }
</style>
