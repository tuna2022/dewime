---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderPlate from "../../components/PlaceholderPlate.astro";
import { SITE } from "../../consts";
import { breadcrumbSchema } from "../../lib/schema";

const projects = (await getCollection("interiorProjects")).sort((a, b) => b.data.year - a.data.year);

const jsonLd = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Interior Projects", path: "/interior-projects" },
]);
---

<BaseLayout
  title="Interior Projects"
  description={`Residential, commercial and restoration interiors by ${SITE.name} across ${SITE.areaServed.join(", ")} and beyond.`}
  path="/interior-projects"
  jsonLd={jsonLd}
>
  <section class="px-6 pt-16 pb-12 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Interior Projects</p>
      <h1 class="mt-4 max-w-2xl font-display text-4xl text-ink md:text-6xl">
        Built interiors across Türkiye.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-ink/75">
        {SITE.areaServed.join(" · ")}
      </p>
    </div>
  </section>

  <section class="border-t border-stone-light/70 px-6 py-12 md:px-10 md:py-20">
    <div class="mx-auto grid max-w-6xl gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((project, i) => (
          <a href={`/interior-projects/${project.id}`} class="group block">
            <PlaceholderPlate
              label={`${project.data.title}, ${project.data.city}`}
              seed={i + 20}
              class="aspect-[4/5] w-full"
            />
            <p class="mt-4 font-mono text-xs uppercase tracking-[0.1em] text-stone">
              {project.data.city} · {project.data.year} · {project.data.category}
            </p>
            <h2 class="mt-1 font-display text-xl text-ink group-hover:text-patina">
              {project.data.title}
            </h2>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
