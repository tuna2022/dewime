---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { breadcrumbSchema } from "../lib/schema";

const jsonLd = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "About", path: "/about" },
]);

const behindTheScenesGallery = [
  { src: "tuna-a1.jpg", alt: "Grinding and fitting metal at the workbench, welding helmet raised", feature: true },
  { src: "tuna-a5.jpg", alt: "On site inside a historic building under restoration, steel armature rising through the room", feature: true },
  { src: "tuna-a7.jpg", alt: "Examining a gem-set ceremonial Ottoman helmet by hand" },
  { src: "tuna-a2.jpg", alt: "Arranging antique silver flatware for a collection review" },
  { src: "tuna-a3.jpg", alt: "Mounting ancient bead necklaces inside a museum display case" },
  { src: "tuna-a6.jpg", alt: "Cataloguing archaeological objects in a museum display case" },
  { src: "tuna-a4.jpg", alt: "Welding at the bench, kneeling beside the workshop table" },
  { src: "tuna-a9.jpg", alt: "Restoration bench work on a blue-and-white ceramic piece" },
  { src: "tuna-a11.jpg", alt: "Cataloguing ancient jewelry and beadwork beside a laptop of archive records" },
  { src: "tuna-a8.jpg", alt: "Grinding steel while a film crew records the process" },
  { src: "tuna-a10.jpg", alt: "At work in the workshop" },
  { src: "tuna-a12.jpg", alt: "Marble sarcophagus gallery at the Istanbul Archaeology Museum", feature: true },
  { src: "tuna-a13.jpg", alt: "Terracotta sarcophagi on display at the Istanbul Archaeology Museum" },
  { src: "tuna-a14.jpg", alt: "Mirrored display pavilion inside a hall at Topkapı Palace Museum" },
] as const;
---

<BaseLayout
  title="About"
  description={`${SITE.name} is an architecture and design-build studio based in ${SITE.address.city}, Türkiye, founded in ${SITE.founded}.`}
  path="/about"
  jsonLd={jsonLd}
>
  <section class="px-6 pt-16 md:px-10 md:pt-24">
    <div class="mx-auto max-w-6xl">
      <p class="coord-mark">Museum practitioner</p>
      <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-4 md:auto-rows-[200px] md:grid-flow-dense md:gap-6">
        {
          behindTheScenesGallery.map((img) => (
            <img
              src={`/images/about/${img.src}`}
              alt={img.alt}
              class={`hover-zoom aspect-[4/3] h-full w-full object-cover ${
                "feature" in img && img.feature
                  ? "col-span-2 aspect-auto md:row-span-2"
                  : ""
              }`}
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-stone-light/70 px-6 pt-16 pb-12 md:px-10 md:pt-24 md:pb-16">
    <div class="mx-auto max-w-3xl">
      <p class="coord-mark">About</p>
      <p class="mt-6 font-display text-2xl leading-snug text-ink md:text-3xl">
        I am a designer specializing in museum implementation projects. Museums typically require
        a labor-intensive, lengthy design process—yet not every project affords that kind of
        time.
      </p>
      <p class="mt-6 text-ink/75">
        Ours is an era that demands speed and practical solutions. That is why I established
        Design Without Memory; I focus on practical solutions for construction projects that
        require rapid, timely execution. Please contact me at{" "}
        <a href="mailto:tunakocayurt@gmail.com" class="text-patina hover:underline">
          tunakocayurt@gmail.com
        </a>{" "}
        for quick solutions.
      </p>
      <p class="mt-6 text-ink/75">
        If time is not a constraint and you require design services involving design with
        memory, please visit this site:{" "}
        <a
          href="https://www.tunakocayurt.com"
          class="text-patina hover:underline"
          target="_blank"
          rel="noopener"
        >
          www.tunakocayurt.com
        </a>
      </p>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
        <a
          href="/non-places"
          class="font-mono text-xs uppercase tracking-[0.14em] text-patina hover:underline"
        >
          Read my notes on "non-places" →
        </a>
        <a
          href="/design-with-memory"
          class="font-mono text-xs uppercase tracking-[0.14em] text-patina hover:underline"
        >
          Read my notes on design with memory →
        </a>
      </div>
    </div>
  </section>

  <section class="px-6 pt-16 pb-12 md:px-10 md:pt-24">
    <div class="mx-auto grid max-w-6xl gap-8 md:grid-cols-2 md:items-center md:gap-16">
      <div class="mx-auto w-full max-w-sm">
        <img
          src="/images/about/tuna.jpg"
          alt={`Tuna Kocayurt on site at a jewelry display case installation`}
          class="h-auto w-full"
        />
      </div>
      <div>
        <h1 class="font-display text-4xl text-ink md:text-6xl">
          Creating a design suited to the times.
        </h1>
        <p class="mt-6 text-lg text-ink/75">
          Established in {SITE.address.city} in {SITE.founded}, {SITE.name} operates in the
          fields of architecture, interiors, and construction, managing projects from the
          initial sketch to the final handover.
        </p>
        <p class="mt-4 text-ink/75">
          I am a designer with extensive experience across a wide range of areas—from the design
          of museum fixtures and product development to lighting design and the creation of
          spatial narratives. I believe that design should be a narrative driven by the element
          of time; therefore, I strive to deliver my best work by focusing closely on the
          client's input and the space itself.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-stone-light/70 bg-paper px-6 py-16 md:px-10 md:py-24">
    <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-2">
      <div>
        <p class="coord-mark">How we work</p>
        <h2 class="mt-3 font-display text-2xl text-ink">Design and construction, one team</h2>
        <p class="mt-4 text-ink/75">
          Splitting design from construction is the single biggest source of budget overruns and
          diluted intent on a building project. Keeping both under one roof means the person who
          drew a detail is the person who can explain it to a contractor on site — and change it
          on the spot if the site calls for it.
        </p>
      </div>
      <div>
        <p class="coord-mark">Where we work</p>
        <h2 class="mt-3 font-display text-2xl text-ink">Based in Istanbul, working nationwide</h2>
        <p class="mt-4 text-ink/75">
          Our studio is in {SITE.address.district}, {SITE.address.city}. We take on projects
          across {SITE.areaServed.join(", ")}, and consider other regions of Türkiye on a
          case-by-case basis. <span lang="tr">Türkiye genelinde mimari tasarım ve uygulama.</span>
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-stone-light/70 px-6 py-16 text-center md:px-10 md:py-24">
    <div class="mx-auto max-w-xl">
      <p class="coord-mark justify-center">Get in touch</p>
      <h2 class="mt-3 font-display text-3xl text-ink">Have a site in mind?</h2>
      <a
        href="/contact"
        class="mt-6 inline-block bg-ink px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-paper hover:bg-patina"
      >
        Start a project
      </a>
    </div>
  </section>
</BaseLayout>
