---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderPlate from "../../components/PlaceholderPlate.astro";
import { breadcrumbSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const practice = await getCollection("practice");
  return practice.map((discipline) => ({
    params: { id: discipline.id },
    props: { discipline },
  }));
}

const { discipline } = Astro.props;
const { Content } = await render(discipline);

const jsonLd = breadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Practice", path: "/practice" },
  { name: discipline.data.title, path: `/practice/${discipline.id}` },
]);
---

<BaseLayout
  title={discipline.data.title}
  description={discipline.data.summary}
  path={`/practice/${discipline.id}`}
  jsonLd={jsonLd}
>
  <section class="px-6 pt-16 pb-10 md:px-10 md:pt-24">
    <div class="mx-auto max-w-3xl">
      <a href="/practice" class="font-mono text-xs uppercase tracking-[0.14em] text-stone hover:text-ink">
        ← All disciplines
      </a>
      <p class="coord-mark mt-6" lang="tr">{discipline.data.titleTr}</p>
      <h1 class="mt-3 font-display text-4xl text-ink md:text-5xl">{discipline.data.title}</h1>
      <p class="mt-6 text-lg text-ink/75">{discipline.data.summary}</p>
    </div>
  </section>

  <PlaceholderPlate
    label={discipline.data.title}
    seed={discipline.data.order + 10}
    class="mx-auto aspect-[21/9] w-full max-w-6xl"
  />

  <section class="px-6 py-16 md:px-10 md:py-24">
    <div class="prose-content mx-auto max-w-3xl text-ink/85">
      <Content />
    </div>

    <div class="mx-auto mt-16 max-w-3xl border-t border-stone-light/70 pt-10">
      <p class="coord-mark">Next step</p>
      <p class="mt-3 max-w-xl text-ink/75">
        Tell us about the site and the brief — we'll follow up with next steps and a rough
        timeline.
      </p>
      <a
        href="/contact"
        class="mt-6 inline-block bg-ink px-6 py-3 font-mono text-xs uppercase tracking-[0.14em] text-paper hover:bg-patina"
      >
        Start a project
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-ink);
  }

  .prose-content :global(p) {
    margin-top: 1rem;
  }

  .prose-content :global(ul) {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .prose-content :global(li) {
    padding-left: 1.25rem;
    position: relative;
  }

  .prose-content :global(li::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.4rem;
    height: 1px;
    background: var(--color-bronze);
  }

  .prose-content :global(strong) {
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
