---
import "../styles/global.css";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { organizationSchema } from "../lib/schema";
import { SITE } from "../consts";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  noindex?: boolean;
  keywords?: readonly string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, path, image, noindex, keywords, jsonLd } = Astro.props;

const schemas = [
  organizationSchema(),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Aimed at both search crawlers and AI answer engines. -->
    <meta name="geo.region" content="TR-34" />
    <meta name="geo.placename" content="Ortaköy, Beşiktaş, Istanbul" />
    <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
    <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <SEO
      title={title}
      description={description}
      path={path}
      image={image}
      noindex={noindex}
      keywords={keywords}
    />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-ink focus:text-paper focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
