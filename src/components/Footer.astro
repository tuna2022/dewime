---
import { SITE, NAV_LINKS } from "../consts";

const year = new Date().getFullYear();
---

<footer class="border-t border-stone-light/70 bg-ink text-canvas">
  <div class="mx-auto max-w-6xl px-6 py-16 md:px-10">
    <div class="grid gap-12 md:grid-cols-[1.3fr_1fr_1fr_1fr]">
      <div>
        <p class="font-display text-2xl">{SITE.name}</p>
        <p class="mt-3 max-w-xs text-sm text-stone-light">{SITE.tagline}.</p>
        <p class="mt-3 max-w-xs text-sm text-stone-light" lang="tr">
          {SITE.descriptionTr}
        </p>
      </div>

      <div>
        <p class="coord-mark text-stone-light">Studio</p>
        <ul class="mt-4 space-y-2 text-sm">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={link.href} class="text-stone-light hover:text-paper">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="coord-mark text-stone-light">Contact</p>
        <ul class="mt-4 space-y-2 text-sm text-stone-light">
          <li><a href={`mailto:${SITE.email}`} class="hover:text-paper">{SITE.email}</a></li>
          <li><a href={`tel:${SITE.phone.replace(/\s/g, "")}`} class="hover:text-paper">{SITE.phoneDisplay}</a></li>
          <li>{SITE.address.district}, {SITE.address.city}</li>
          <li>{SITE.address.country}</li>
        </ul>
      </div>

      <div>
        <p class="coord-mark text-stone-light">Follow</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href={SITE.social.instagram} class="text-stone-light hover:text-paper">Instagram</a></li>
          <li><a href={SITE.social.linkedin} class="text-stone-light hover:text-paper">LinkedIn</a></li>
          <li><a href={SITE.social.pinterest} class="text-stone-light hover:text-paper">Pinterest</a></li>
        </ul>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-2 border-t border-stone/30 pt-6 font-mono text-xs uppercase tracking-[0.1em] text-stone md:flex-row md:items-center md:justify-between"
    >
      <p>© {year} {SITE.legalName}. All rights reserved.</p>
      <p>{SITE.geo.lat.toFixed(4)}° N, {SITE.geo.lng.toFixed(4)}° E</p>
    </div>
  </div>
</footer>
