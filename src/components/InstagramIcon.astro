---
interface Props {
  class?: string;
}

const { class: className = "h-4 w-4" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  aria-hidden="true"
>
  <rect x="3" y="3" width="18" height="18" rx="5" />
  <circle cx="12" cy="12" r="4.2" />
  <circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none" />
</svg>
