---
import { SITE, NAV_LINKS } from "../consts";
import InstagramIcon from "./InstagramIcon.astro";
---

<header
  class="sticky top-0 z-50 border-b border-stone-light/70 bg-canvas/85 backdrop-blur"
>
  <div class="mx-auto max-w-6xl px-6 py-4 md:px-10">
    <div class="flex items-center justify-between gap-6">
      <a href="/" class="leading-none">
        <img
          src="/images/logo/dewimelogo-crop.png"
          alt="DeWiMe"
          width="544"
          height="129"
          class="h-7 w-auto lg:h-8"
        />
      </a>

      <div class="flex items-center gap-4">
        <a
          href={SITE.social.instagram}
          target="_blank"
          rel="noopener"
          aria-label={`${SITE.name} on Instagram`}
          class="text-stone transition-colors hover:text-ink"
        >
          <InstagramIcon class="h-5 w-5" />
        </a>

        <button
          id="menu-toggle"
          type="button"
          class="flex flex-col gap-1.5 xl:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle menu"
        >
          <span class="h-px w-6 bg-ink"></span>
          <span class="h-px w-6 bg-ink"></span>
        </button>
      </div>
    </div>

    <!-- Only from xl up: below that the links don't fit on one line, so they live in the toggle menu. -->
    <nav class="mt-3 hidden items-center justify-between gap-5 xl:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) =>
          "children" in link ? (
            <div class="group relative">
              <a
                href={link.href}
                class="inline-flex items-center gap-1.5 whitespace-nowrap font-mono text-xs uppercase tracking-[0.1em] text-stone transition-colors hover:text-ink group-focus-within:text-ink group-hover:text-ink"
              >
                {link.label}
                <span aria-hidden="true" class="text-[0.6rem]">▾</span>
              </a>
              <div class="invisible absolute top-full left-0 z-50 pt-3 opacity-0 transition-opacity group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
                <ul class="min-w-44 border border-stone-light/70 bg-canvas py-2 shadow-sm">
                  {link.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class="block whitespace-nowrap px-4 py-2 font-mono text-xs uppercase tracking-[0.1em] text-stone transition-colors hover:bg-paper hover:text-ink"
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class:list={[
                "whitespace-nowrap font-mono text-xs uppercase tracking-[0.1em] transition-colors",
                link.href === "/design-with-memory"
                  ? "text-red-600 hover:text-red-800"
                  : "text-stone hover:text-ink",
              ]}
            >
              {link.label}
            </a>
          )
        )
      }
    </nav>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-stone-light/70 bg-canvas px-6 py-4 xl:hidden"
    aria-label="Primary mobile"
  >
    {
      NAV_LINKS.map((link) => (
        <>
          <a
            href={link.href}
            class:list={[
              "py-2 font-mono text-sm uppercase tracking-[0.14em]",
              link.href === "/design-with-memory"
                ? "text-red-600 hover:text-red-800"
                : "text-stone hover:text-ink",
            ]}
          >
            {link.label}
          </a>
          {"children" in link &&
            link.children.map((child) => (
              <a
                href={child.href}
                class="border-l border-stone-light py-1.5 pl-4 font-mono text-xs uppercase tracking-[0.14em] text-stone hover:text-ink"
              >
                {child.label}
              </a>
            ))}
        </>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("flex");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(Boolean(isOpen)));
  });
</script>
